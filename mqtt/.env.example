MQTT_LISTENER_TCP=1883
MQTT_LISTENER_TLS=8883
MQTT_LISTENER_WS=8083

# IP de esta máquina en la LAN donde se publica el puerto MQTT TLS (mTLS) para dispositivos
# reales (por defecto solo 127.0.0.1). No afecta a 1883, WebSocket ni al panel. Usar el mismo
# valor que en backend/.env.
# LAN_BIND_IP=192.168.1.50

# Generar con: openssl rand -hex 64
EMQX_PASSWORD="changeme"

# Generar con: openssl rand -hex 32
EMQX_BACKEND_PASSWORD="<la que generes>"