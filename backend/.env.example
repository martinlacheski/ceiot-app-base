# --- PROYECTO ---
PROJECT_NAME="IoT-Base-App"
# LOCAL: DEV  |  PROD: PROD
ENVIRONMENT="DEV"
MAX_UPLOAD_MB=20

# --- SEGURIDAD ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CONEXIÓN BACKEND ---
# LOCAL: http://localhost:8000  |  PROD: https://api.url.com
BACKEND_HOST_URL="http://localhost:8000"
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
# LOCAL: orígenes de desarrollo
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# MQTT
# LOCAL: localhost  |  PROD: emqx (nombre del servicio Docker)
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_USER=admin
EMQX_PASSWORD=changeme
# LOCAL: Backend-Dev  |  PROD: Backend-Prod
MQTT_CLIENT_ID=Backend-Dev
CERTS_DIR_BACKEND=/app/certs/

# --- FRONTEND ---
VITE_FRONTEND_URL="http://localhost:5173"
VITE_FRONTEND_PORT=5173
VITE_API_URL="${BACKEND_HOST_URL}/api"
VITE_SESSION_TIMEOUT=30

# --- EMAIL ---
EMAIL_HOST="smtp.gmail.com"
MAIL_SERVER=${EMAIL_HOST}
MAIL_PORT=587
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM=${MAIL_USERNAME}
MAIL_FROM_NAME="IoT App"

# Configuración SSO Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Google Maps API KEY ---
GCP_API_KEY=your-gcp-api-key

# Ruta Certificados
CERTS_DIR_BACKEND=/app/certs/

# ===== Mercado Pago base =====
MP_API_BASE_URL=https://api.mercadopago.com
MP_AUTH_BASE_URL=https://auth.mercadopago.com.ar
# LOCAL: URL de ngrok  |  PROD: https://api.url.com/api/mp-callback
MP_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/api/mp-callback

# ===== Numero de Aplicacion =====
# Produccion: 4473045735089341
# Prueba:     5218385949715777
MP_NUMBER_APLICATTION=your-mp-app-id

# ===== Client Secret =====
# Produccion: ver credenciales PROD
# Prueba:     ver credenciales TEST
MP_CLIENT_SECRET=your-mp-client-secret

# ===== Security Key =====
MP_SECURITY_KEY=your-mp-security-key

# ===== Access Token =====
# Produccion: APP_USR-...
# Prueba:     APP_USR-...
MP_ACCESS_TOKEN=your-mp-access-token

# ===== User ID =====
# Produccion: 123456789
# Prueba:     123456789
MP_USER_ID=your-mp-user-id

# ===== Webhooks =====
# LOCAL: URL de ngrok  |  PROD: https://api.url.com/api
MP_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/api
MP_VALIDATE_QR_WEBHOOK_SIGNATURE=false

# ===== QR / estrategia =====
MP_QR_EXPIRES_IN_MINUTES=10
IOT_INIT_POINT_FORCE_STRATEGY=orders
IOT_INIT_POINT_DEFAULT_STRATEGY=orders
IOT_INIT_POINT_DEVICE_RULES={}
IOT_INIT_POINT_COHORT_RULES=[]

# ===== Marketplace =====
# Produccion: 26975275  |  Prueba: 3247110386
MP_SPONSOR_ID=your-mp-sponsor-id

MP_MARKETPLACE_ENABLED=true
MP_DEFAULT_MARKETPLACE_FEE=5.0
# Configuracion de Devolucion MP
MP_DISPENSE_ACK_TIMEOUT_SECONDS=30
MP_REFUND_ENABLED=true
MP_REFUND_WORKER_INTERVAL_SECONDS=5
MP_REFUND_RETRY_INITIAL_SECONDS=30
MP_REFUND_RETRY_MAX_SECONDS=90

# MQTT
MQTT_TOPIC_DEVICE_SUB=iot/devices/+/events
