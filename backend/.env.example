# --- PROYECTO ---
PROJECT_NAME="IoT-Base-App"
# LOCAL: DEV  |  PROD: PROD
ENVIRONMENT="DEV"
MAX_UPLOAD_MB=20

# --- SEGURIDAD ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CONEXIÓN BACKEND ---
# LOCAL: http://localhost:8000  |  PROD: https://api.url.com
BACKEND_HOST_URL="http://localhost:8000"
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
# LOCAL: orígenes de desarrollo
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# --- ACCESO DESDE LA RED LOCAL (dispositivos reales) ---
# IP de esta máquina en la LAN donde se publica el puerto HTTP del backend (por defecto solo
# 127.0.0.1). Usar el mismo valor que en mqtt/.env.
# LAN_BIND_IP=192.168.1.50
# Base de la URL de descarga de firmware que reciben los dispositivos (OTA). Si no se define,
# se usa BACKEND_PUBLIC_BASE_URL y luego BACKEND_HOST_URL.
# FIRMWARE_DOWNLOAD_BASE_URL=http://192.168.1.50:18000

# MQTT
# LOCAL: localhost  |  PROD: emqx (nombre del servicio Docker)
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_USER=admin
EMQX_PASSWORD=changeme
EMQX_API_BASE_URL=http://emqx:18083
EMQX_API_KEY=your-emqx-api-key
EMQX_API_SECRET=your-emqx-api-secret
# LOCAL: Backend-Dev  |  PROD: Backend-Prod
MQTT_CLIENT_ID=Backend-Dev
CERTS_DIR_BACKEND=/app/certs/
MQTT_TOPIC_DEVICE_SUB=iot/devices/+/events

# --- FRONTEND ---
VITE_FRONTEND_URL="http://localhost:5173"
VITE_FRONTEND_PORT=5173
VITE_API_URL="${BACKEND_HOST_URL}/api"
VITE_SESSION_TIMEOUT=30

# --- EMAIL ---
EMAIL_HOST="smtp.gmail.com"
MAIL_SERVER=${EMAIL_HOST}
MAIL_PORT=587
MAIL_USERNAME="your-email@email.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM=${MAIL_USERNAME}
MAIL_FROM_NAME="IoT App"

# Configuración SSO Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Google Maps API KEY ---
GCP_API_KEY=your-gcp-api-key

# Ruta Certificados
CERTS_DIR_BACKEND=/app/certs/

# --- ASISTENTE / RAG (opcional; sin estas variables el asistente responde 503) ---
OPENROUTER_API_KEY="<tu clave>"
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Embeddings (BAAI/bge-m3, 1024 dimensiones): "openrouter" (usa OPENROUTER_API_KEY) o "local"
# (contenedor TEI del perfil embeddings-local; no necesita clave).
EMBEDDING_PROVIDER="openrouter"
# EMBEDDING_PROVIDER="local"

EMBEDDING_LOCAL_URL="http://embeddings:80"   # ya lo define docker-compose
MODELO_EMBEDDING="BAAI/bge-m3"
RAG_MAX_COSINE_DISTANCE=0.55   # corte de distancia coseno; recalibrar si cambia el modelo
RAG_TOP_K=4                    # fragmentos por consulta (máximo 8)
