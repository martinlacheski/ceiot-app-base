# Backend (API FastAPI y mqtt-runtime).
# Copiar a backend/.env y completar los valores marcados con CAMBIAR o vacíos.
# Usar valores sin espacios ni comillas salvo donde se indica.
#
# Docker Compose arma DATABASE_URL (usuario de la aplicación DB_USER, sin
# privilegios) y ALEMBIC_DATABASE_URL (superusuario ALEMBIC_DB_USER) con las
# credenciales de timescaledb/.env, y EMQX_USER / EMQX_PASSWORD con
# EMQX_BACKEND_PASSWORD de mqtt/.env: no se definen acá.

# --- Proyecto ---
PROJECT_NAME="Monitoreo Ambiental IoT"
# DEV habilita /api/docs y cookies sin Secure; PROD las desactiva.
ENVIRONMENT=DEV
MAX_UPLOAD_MB=3

# --- Servidor ---
# Puerto publicado en el host (dentro de Docker el backend siempre escucha en
# 8000). Si 8000 está ocupado en su máquina, elija otro y actualice las URLs
# de frontend/.env y landing/.env.
BACKEND_PORT=8000
# Origen del backend sin puerto; las URLs absolutas se arman con BACKEND_PORT.
BACKEND_HOST_URL=http://localhost
# Opcional: URL pública completa (con puerto) cuando difiere de la anterior.
BACKEND_PUBLIC_BASE_URL=
# IP de esta máquina en la red local, para dispositivos reales (mismo valor que
# en mqtt/.env). Vacía: el backend se publica solo en 127.0.0.1.
LAN_BIND_IP=
# Base de la URL de descarga de firmware (OTA) que reciben los dispositivos;
# debe ser alcanzable desde la red local, p. ej. http://192.168.1.50:8000.
# Vacía: usa BACKEND_PUBLIC_BASE_URL y, si tampoco está, BACKEND_HOST_URL.
FIRMWARE_DOWNLOAD_BASE_URL=
# Listas JSON. Agregue el origen de cada interfaz que llama a la API y, para
# OTA desde dispositivos reales, la IP de LAN_BIND_IP en los hosts confiables.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:4321"]
BACKEND_TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]

# --- Frontend (enlaces en correos, CORS y OAuth) ---
VITE_FRONTEND_URL=http://localhost
VITE_FRONTEND_PORT=5173

# --- Autenticación ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=CAMBIAR_generar_con_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Administrador inicial ---
# Solo se usa cuando la base todavía no tiene ningún administrador (primer
# arranque); nunca modifica cuentas existentes. Sin estos valores el backend no
# arranca contra una base vacía. La contraseña debe tener al menos 8
# caracteres, una mayúscula, una minúscula y un número.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- MQTT (listener TCP interno de EMQX; usuario backend-services) ---
EMQX_HOST=emqx
EMQX_PORT=1883
MQTT_TOPIC_DEVICE_SUB=iot/devices/#
# Opcional: API de administración de EMQX para la presencia de dispositivos.
# EMQX_API_KEY y EMQX_API_SECRET deben tener los mismos valores en mqtt/.env
# (el broker los registra al arrancar). Generar con: openssl rand -hex 16 / 32
EMQX_API_BASE_URL=http://emqx:18083
# EMQX_API_KEY=
# EMQX_API_SECRET=

# --- Correo ---
# mailpit: los correos quedan en Mailpit (http://localhost:8025) y nunca se
# entregan. smtp: entrega real con los valores MAIL_* de abajo.
MAIL_TRANSPORT=mailpit
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Monitoreo Ambiental IoT"
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
# Opcional: destino del formulario de contacto de la landing (por defecto MAIL_FROM).
# CONTACT_RECIPIENT=contacto@example.com

# --- Asistente IA y embeddings (opcionales) ---
# Sin OPENROUTER_API_KEY el asistente responde 503; el resto funciona igual.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# openrouter (usa OPENROUTER_API_KEY) o local (contenedor de embeddings, perfil
# embeddings-local; scripts/levantar.sh lo crea solo con este valor).
EMBEDDING_PROVIDER=openrouter

# --- Inicio de sesión con Google (opcional, ver docs/configuracion-google-oauth.md) ---
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
