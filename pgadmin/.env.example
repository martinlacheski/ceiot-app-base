# pgAdmin (explorador de la base de datos, solo desarrollo). Copiar a
# pgadmin/.env. Sin estas variables el contenedor de pgAdmin no arranca; el
# resto del stack funciona igual. La conexión a TimescaleDB se configura sola
# con las credenciales de timescaledb/.env.
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Generar con: openssl rand -hex 16
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_generar_con_openssl_rand_hex_16
