# Almacenamiento de objetos (SeaweedFS S3) del módulo Documentos. Opcional:
# copiar a seaweedfs/.env para activarlo. Sin las claves, el módulo responde
# 503 y el resto de la aplicación funciona igual.
# Solo letras y números (sin comillas, barras invertidas ni espacios).
# Generar con: openssl rand -hex 12
S3_ACCESS_KEY=
# Generar con: openssl rand -hex 32
S3_SECRET_KEY=
