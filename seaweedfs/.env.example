# Copiar a seaweedfs/.env (git-ignorado). Si faltan, el almacenamiento queda
# deshabilitado (el modulo Documentos responde 503) pero el resto del stack arranca.

# Generar con: openssl rand -hex 12
S3_ACCESS_KEY="<la que generes>"

# Generar con: openssl rand -hex 32
S3_SECRET_KEY="<la que generes>"
