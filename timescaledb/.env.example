# PostgreSQL + TimescaleDB. Copiar a timescaledb/.env.
#
# Dos usuarios (ver docs/roles-base-de-datos.md):
# - ALEMBIC_DB_USER: superusuario del servidor. Es dueño de todos los objetos y
#   lo usan las migraciones (Alembic), los trabajos de TimescaleDB, los backups
#   y pgAdmin.
# - DB_USER: usuario de la aplicación (API y mqtt-runtime), sin SUPERUSER ni
#   BYPASSRLS, así que Row Level Security filtra sus consultas.
#
# El backend, mqtt-runtime y pgAdmin arman su conexión con estas credenciales
# y siempre usan postgresql:5432 dentro de Docker. Los usuarios se crean solo
# al crear el volumen de datos (primer arranque): cambiarlos después no
# modifica los existentes. En una instalación anterior, donde DB_USER era el
# superusuario, agregue ALEMBIC_DB_USER y ALEMBIC_DB_PASSWORD y ejecute
# scripts/separar-roles-db.sh.

# Puerto publicado en 127.0.0.1 para herramientas del host (psql, IDE). Si en
# su máquina ya hay un PostgreSQL usando 5432, elija otro (p. ej. 15432); no
# afecta a los contenedores.
DB_PORT=5432
DB_DATABASE=iot_app

# Usuario de la aplicación. Solo letras minúsculas, números y _.
DB_USER=iot_app
# Solo letras y números (se usa dentro de la URL de conexión).
# Generar con: openssl rand -hex 24
DB_PASSWORD=CAMBIAR_generar_con_openssl_rand_hex_24

# Superusuario de migraciones, distinto de DB_USER y con otra contraseña.
ALEMBIC_DB_USER=iot_app_admin
# Generar con: openssl rand -hex 24
ALEMBIC_DB_PASSWORD=CAMBIAR_generar_con_openssl_rand_hex_24
