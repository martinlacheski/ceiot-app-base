# --- BASE DE DATOS ---
# LOCAL: localhost  |  PROD: postgresql (nombre del servicio Docker)
DB_HOST=localhost
DB_PORT=5432

# Para generar la clave de usuario... Ejecutar: openssl rand -hex 16

# Usuario de aplicación (runtime) — sujeto a RLS
DB_USER=iot_app
DB_PASSWORD=changeme

# Usuario de migraciones (Alembic) — superusuario, bypasea RLS
ALEMBIC_DB_USER=postgres_admin
ALEMBIC_DB_PASSWORD=changeme

DB_DATABASE=iot_db
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}
ALEMBIC_DATABASE_URL=${DATABASE_URL}