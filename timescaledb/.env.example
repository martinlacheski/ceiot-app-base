# PostgreSQL + TimescaleDB. Copiar a timescaledb/.env.
#
# El backend, mqtt-runtime y pgAdmin arman su conexión con estas credenciales
# y siempre usan postgresql:5432 dentro de Docker. Las credenciales se aplican
# solo al crear el volumen de datos (primer arranque): cambiarlas después no
# modifica el usuario existente.

# Puerto publicado en 127.0.0.1 para herramientas del host (psql, IDE). Si en
# su máquina ya hay un PostgreSQL usando 5432, elija otro (p. ej. 15432); no
# afecta a los contenedores.
DB_PORT=5432
DB_USER=iot
# Solo letras y números (se usa dentro de la URL de conexión).
# Generar con: openssl rand -hex 24
DB_PASSWORD=CAMBIAR_generar_con_openssl_rand_hex_24
DB_DATABASE=iot_app
