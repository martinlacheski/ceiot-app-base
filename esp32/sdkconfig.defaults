# CEIoT environmental device: classic ESP32 (ESP32-WROOM-32, ESP32-D0WD-V3),
# 4 MB flash, no PSRAM. ESP-IDF 6.1.

# Target
CONFIG_IDF_TARGET="esp32"

# Flash: 4 MB, custom partition table (two OTA slots, no factory app)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Smaller application image (the OTA slot is 1920 KB)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# CPU / FreeRTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# SNTP: allow the DHCP-provided server plus two public ones
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# MQTT (espressif/mqtt component): MQTT 3.1.1 over TLS only
CONFIG_MQTT_PROTOCOL_5=n
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# mbedTLS without PSRAM: allocate the TLS record buffers on demand to keep
# internal RAM free for Wi-Fi, the web server and the MQTT client.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# CONFIG_MBEDTLS_HAVE_TIME_DATE stays disabled (ESP-IDF default): the broker
# chain and signatures are verified, but the certificate validity dates are
# not compared with the system clock. That is what lets the device reach the
# broker (and ask for the time over MQTT) when NTP and HTTP both failed.
# See README.md, "Sincronización horaria".

# DVEM change 50 adapted to this board (no PSRAM, see README "Actualizaciones OTA"):
# mbedTLS cannot move to PSRAM (CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC needs it) and
# hardware AES stays on: the classic ESP32 AES accelerator has no DMA, so the
# "esp-aes: Failed to allocate memory" DMA bounce buffer of the S3 does not
# exist here. The dynamic buffers above keep the MQTT mTLS session small, and
# the OTA client checks the free heap before an http/https download.
# https OTA downloads verify the server with the certificate bundle; the
# common-CA bundle (~40 KB of flash instead of ~68 KB) covers public CAs such
# as Let's Encrypt.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# HTTP server (configuration web UI)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# OTA: new images boot in PENDING_VERIFY and roll back unless validated
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Watchdog
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
# Only the tasks that subscribe are watched (app_main, see utils/watchdog.c):
# the idle tasks are left out here instead of being unsubscribed at runtime.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Core dump to the `coredump` partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
