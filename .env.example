# Valores compartidos por varios servicios. Copiar a .env (en la raíz del
# repositorio) y ajustar.
#
# scripts/levantar.sh y `docker compose` (desde la raíz) leen este archivo
# antes que el .env de cada servicio: cada servicio arma sus URLs con estos
# valores, así cada puerto y host se escribe una sola vez. Un valor definido en
# el .env de un servicio (p. ej. VITE_API_URL en frontend/.env) reemplaza al
# derivado.

# --- Acceso desde el navegador ---
# Esquema y host con los que el navegador llega al stack.
PUBLIC_SCHEME=http
PUBLIC_HOST=localhost

# --- Puertos publicados en el host ---
# Dentro de Docker el backend escucha en 8000 y frontend/landing en 80. Si
# alguno está ocupado en su máquina, cámbielo solo acá.
BACKEND_PORT=8000
FRONTEND_PORT=5173
LANDING_PORT=4321

# --- Dispositivos reales en la red local ---
# IP de esta máquina en la red local. Vacía: el backend y el puerto TLS de MQTT
# se publican solo en 127.0.0.1. Con un valor, también se publican en esa IP,
# el backend la acepta como host y la usa como base de descarga de firmware
# (OTA), y mqtt/pki/emitir-certificado-broker.sh la incluye en el certificado
# del broker.
LAN_BIND_IP=

# --- Google Maps ---
# Clave del NAVEGADOR (Maps JavaScript API y Places): mapas del frontend y de
# la landing. Restrínjala por sitio web (localhost:4321 y localhost:5173).
# Sin una clave válida la aplicación funciona, pero los mapas no cargan.
GOOGLE_MAPS_API_KEY=
# Clave del SERVIDOR (Geocoding API): el backend la usa para resolver
# direcciones. Sin restricción por sitio web (Google rechaza esas claves desde
# un servidor). Vacía: el backend usa GOOGLE_MAPS_API_KEY.
GCP_API_KEY=

# --- API de administración de EMQX ---
# La usan el broker (la registra al arrancar) y el backend para saber qué
# dispositivos están conectados (estado en línea y OTA).
# Generar con: openssl rand -hex 16
EMQX_API_KEY=
# Generar con: openssl rand -hex 32
EMQX_API_SECRET=
