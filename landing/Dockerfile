FROM node:22-alpine AS builder
WORKDIR /app

ARG PUBLIC_APP_LOGIN_URL
ARG PUBLIC_WHATSAPP_NUMBER
ARG PUBLIC_SITE_URL
ARG PUBLIC_API_BASE_URL
ARG PUBLIC_GCP_MAPS_API_KEY
ARG PUBLIC_MAP_LOCATIONS_URL

ENV PUBLIC_APP_LOGIN_URL=$PUBLIC_APP_LOGIN_URL
ENV PUBLIC_WHATSAPP_NUMBER=$PUBLIC_WHATSAPP_NUMBER
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL
ENV PUBLIC_GCP_MAPS_API_KEY=$PUBLIC_GCP_MAPS_API_KEY
ENV PUBLIC_MAP_LOCATIONS_URL=$PUBLIC_MAP_LOCATIONS_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
