---
import NotFoundPage from "../components/NotFoundPage.astro";
import { getLandingContent, LOCALES } from "../i18n/content";
import { getNotFoundContent } from "../i18n/notFound";
import BaseLayout from "../layouts/BaseLayout.astro";

const content = getLandingContent(LOCALES.ES);
const notFound = getNotFoundContent(LOCALES.ES);
---

<BaseLayout
  content={content}
  metadata={{
    title: notFound.title,
    description: notFound.description,
    robots: "noindex, follow",
    canonicalPath: "/404.html",
    includeAlternates: false,
    includeJsonLd: false,
  }}
>
  <NotFoundPage content={content} notFound={notFound} />
</BaseLayout>
