---
import { APP_LOGIN_URL } from "../config/publicUrls";
import type { LandingContent } from "../i18n/content";
import BrandIcon from "./BrandIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  content: LandingContent;
  showContact?: boolean;
  /** Prefix for in-page fragment links, so pages other than home link back to home sections. */
  linkBase?: string;
}

const { content, showContact = false, linkBase = "" } = Astro.props;
const privacyLink = content.footer.links.find((link) => link.href === "/privacidad/");
const navLinks = [
  ...content.nav.links,
  ...(showContact ? [{ href: "#contact", label: content.nav.contactLabel }] : []),
  ...(privacyLink ? [privacyLink] : []),
].map((link) => (link.href.startsWith("#") ? { ...link, href: `${linkBase}${link.href}` } : link));
---
<header class="sticky top-0 z-20 border-b border-border/80 bg-background/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-6 py-2.5 xl:px-8">
    <a class="inline-flex min-w-0 items-center gap-3" href={content.path} aria-label={content.hero.heading}>
      <BrandIcon class="size-10 shrink-0" />
      <span class="hidden text-sm font-semibold sm:block">{content.nav.tagline}</span>
    </a>
    <nav class="hidden items-center gap-5 lg:flex">
      {navLinks.map((link) => <a class="text-sm text-muted-foreground transition hover:text-foreground" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-1 rounded-full border border-border bg-card p-1 sm:flex" aria-label={content.nav.localeLabel}>
        {content.nav.locales.map((localeLink) => <a class:list={["rounded-full px-3 py-1 text-xs font-medium", localeLink.href === content.path ? "bg-secondary" : "text-muted-foreground"]} href={localeLink.href}>{localeLink.label}</a>)}
      </div>
      <ThemeToggle labels={{ toggle: content.nav.themeToggleLabel, light: content.nav.themeLightLabel, dark: content.nav.themeDarkLabel }} />
      {APP_LOGIN_URL ? (
        <a class="hidden whitespace-nowrap rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground sm:inline-flex" href={APP_LOGIN_URL}>{content.hero.appCta}</a>
      ) : (
        <span class="hidden whitespace-nowrap rounded-full bg-muted px-4 py-2 text-sm font-semibold text-muted-foreground sm:inline-flex" aria-disabled="true">{content.hero.appCta}</span>
      )}
      <details class="group relative lg:hidden">
        <summary class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-full border border-border" aria-label={content.nav.mobileMenuLabel}>☰</summary>
        <div class="absolute right-0 top-full mt-3 grid w-64 gap-3 rounded-2xl border border-border bg-background p-4 shadow-lg">
          {navLinks.map((link) => <a class="rounded-lg px-3 py-2 text-sm" href={link.href}>{link.label}</a>)}
          <div class="grid grid-cols-3 gap-1" aria-label={content.nav.localeLabel}>
            {content.nav.locales.map((localeLink) => <a class="rounded-lg bg-secondary px-2 py-2 text-center text-xs" href={localeLink.href}>{localeLink.label}</a>)}
          </div>
          {APP_LOGIN_URL ? <a class="rounded-full bg-primary px-4 py-2 text-center text-sm font-semibold text-primary-foreground" href={APP_LOGIN_URL}>{content.hero.appCta}</a> : <span class="rounded-full bg-muted px-4 py-2 text-center text-sm text-muted-foreground" aria-disabled="true">{content.hero.appCta}</span>}
        </div>
      </details>
    </div>
  </div>
</header>
