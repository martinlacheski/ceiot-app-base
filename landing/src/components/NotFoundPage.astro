---
import type { LandingContent } from "../i18n/content";
import type { NotFoundContent } from "../i18n/notFound";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

interface Props { content: LandingContent; notFound: NotFoundContent }
const { content, notFound } = Astro.props;
---
<Navbar content={content} />
<main>
  <section class="section-shell">
    <div class="section-container min-h-[calc(100vh-73px)] justify-center py-20">
      <div class="grid items-center gap-10 md:grid-cols-[1.2fr_0.8fr]">
        <div class="flex flex-col items-start gap-5">
          <p class="eyebrow">{notFound.eyebrow}</p>
          <h1 class="text-5xl font-bold tracking-tighter md:text-6xl">{notFound.heading}</h1>
          <p class="section-copy">{notFound.copy}</p>
          <a class="rounded-full bg-primary px-6 py-3 font-semibold text-primary-foreground" href={content.path}>{notFound.primaryCta}</a>
        </div>
        <div class="mx-auto flex aspect-square w-full max-w-sm items-center justify-center rounded-[2rem] border border-border bg-white p-10">
          <img src="/iot.png" width="512" height="511" alt={notFound.imageAlt} class="h-full w-full object-contain" />
        </div>
      </div>
    </div>
  </section>
</main>
<Footer content={content} />
