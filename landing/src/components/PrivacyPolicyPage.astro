---
import { getLandingContent, landingLocales, type LandingContent } from "../i18n/content";
import { getPrivacyContent, PRIVACY_PATHS } from "../i18n/privacy";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";

interface Props { content: LandingContent }
const { content } = Astro.props;
const privacy = getPrivacyContent(content.locale);
const localeLinks = landingLocales.map((locale) => {
  const homePath = getLandingContent(locale).path;
  const link = content.nav.locales.find((item) => item.href === homePath);
  if (!link) throw new Error(`Missing locale link for ${locale}`);
  return { ...link, href: PRIVACY_PATHS[locale] };
});
---

<Navbar content={content} showContact linkBase={content.path} localeLinks={localeLinks} activeLocaleHref={privacy.path} />

<main>
  <section class="section-shell">
    <div class="section-container py-16 md:py-24">
      <p class="eyebrow">{privacy.eyebrow}</p>
      <h1 class="text-4xl font-bold leading-tight tracking-tighter md:text-5xl">{privacy.title}</h1>
      <p class="text-sm text-muted-foreground">{privacy.updatedLabel}: {privacy.updatedDate}</p>

      <div class="mt-4 flex flex-col gap-10">
        {privacy.sections.map((section, index) => (
          <section class="flex flex-col gap-3" aria-labelledby={`privacy-${index + 1}`}>
            <h2 id={`privacy-${index + 1}`} class="text-xl font-bold tracking-tight md:text-2xl">
              {index + 1}. {section.heading}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p class="body-copy text-base leading-7 text-muted-foreground">{paragraph}</p>
            ))}
          </section>
        ))}
      </div>
    </div>
  </section>
</main>

<Footer content={content} localeLinks={localeLinks} />
