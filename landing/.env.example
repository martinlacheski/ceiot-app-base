# Landing pública (Astro). Copiar a landing/.env.
#
# docker-compose.yml interpola este archivo para el puerto publicado y para los
# argumentos de compilación de la imagen. Las PUBLIC_* quedan fijas en el sitio
# generado: si cambian, reconstruya la imagen (scripts/levantar.sh --build).

# Puerto publicado en 127.0.0.1 (dentro del contenedor, Nginx escucha en 80).
LANDING_PORT=4321
# Botón "Ingresar": login del frontend (VITE_FRONTEND_PORT de frontend/.env).
PUBLIC_APP_LOGIN_URL=http://localhost:5173/auth/login
# API del backend con el sufijo /api. El formulario de contacto usa
# <PUBLIC_API_BASE_URL>/public/contact: el origen de la landing debe estar en
# BACKEND_CORS_ORIGINS de backend/.env.
PUBLIC_API_BASE_URL=http://localhost:8000/api
# Clave de Google Maps para el mapa de ubicaciones.
PUBLIC_GCP_MAPS_API_KEY=
# Opcionales (vacías: valores por defecto).
# URL canónica del sitio para SEO, p. ej. https://www.ejemplo.com
PUBLIC_SITE_URL=
# Origen de las ubicaciones del mapa; por defecto
# <PUBLIC_API_BASE_URL>/public/map/locations.
PUBLIC_MAP_LOCATIONS_URL=
# Número de WhatsApp en formato internacional sin "+" ni espacios (8 a 15
# dígitos), p. ej. 5491100000000. Vacío: no se muestra el botón.
PUBLIC_WHATSAPP_NUMBER=
