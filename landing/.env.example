# Landing-only public env example.
# SPA local `VITE_*` overrides belong in the repo root `.env`, not `frontend/.env`,
# because `frontend/vite.config.ts` loads env from `envDir: ".."`.
# LOCAL: http://localhost:5173/auth/login  |  PROD: https://app.url.com/auth/login
PUBLIC_APP_LOGIN_URL=http://localhost:5173/auth/login
# LOCAL: http://localhost:8000/api  |  PROD: /api (same-origin reverse proxy)
PUBLIC_API_BASE_URL=http://localhost:8000/api
# Google Maps API key (restricted by HTTP referrer, safe for client-side exposure).
# Prefer the Maps-specific name. PUBLIC_GCP_API_KEY is accepted as a legacy local alias.
PUBLIC_GCP_MAPS_API_KEY=your_google_maps_api_key
# Optional override only. Leave empty to use <PUBLIC_API_BASE_URL>/public/map/locations.
# For a static fallback override, set /map-locations.json explicitly.
PUBLIC_MAP_LOCATIONS_URL=

# WhatsApp: numero internacional, solo digitos, sin signo +
PUBLIC_WHATSAPP_NUMBER=5491112345678
