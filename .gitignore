# Local Pi runtime state and agents
.atl/
.codegraph/
odd/

# Local environment and secret material
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.crt
*.csr
*.srl
# Generated certificates, keys and service data: the folders are versioned
# (placeholders *.example and .gitkeep) so a fresh clone has the layout, but
# their real contents never are.
mqtt/certs/*
!mqtt/certs/*.example
mqtt/data/*
!mqtt/data/.gitkeep
mqtt/log/*
!mqtt/log/.gitkeep
mqtt/pki/ca/*
!mqtt/pki/ca/.gitkeep
mqtt/pki/devices/*
!mqtt/pki/devices/.gitkeep
redis/data/*
!redis/data/.gitkeep
seaweedfs/data/*
!seaweedfs/data/.gitkeep
esp32/cert/*
!esp32/cert/*.example
provisioning/build/
provisioning/.env.local
backend/postgres_data/
# Backups (scripts/backup.sh): application data, never versioned.
backups/

# Generated dependencies, caches, and build output
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/dist/
**/coverage/
*.py[cod]
*.log

# Vitest reports and artifacts
.vitest/

# Python virtual environments (e.g. for tools/emulador-dispositivo.py)
.venv/
venv/
backend/.venv/

# Firmware archive: .elf files are kept locally only (core dump decoding)
firmwares/**/*.elf
