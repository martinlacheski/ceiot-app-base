# Frontend (React + Vite). Copiar a frontend/.env.
#
# Docker: docker-compose.yml interpola el .env de la raíz y después este
# archivo para el puerto publicado y los argumentos de compilación de la
# imagen. Las URLs se arman con PUBLIC_SCHEME, PUBLIC_HOST, BACKEND_PORT,
# FRONTEND_PORT y LANDING_PORT del .env de la raíz, y la clave de mapas con
# GOOGLE_MAPS_API_KEY. Las VITE_* quedan fijas en el bundle: si cambian,
# reconstruya la imagen (scripts/levantar.sh --build).
#
# `npm run dev` (fuera de Docker) NO lee este archivo: Vite toma las variables
# del .env de la raíz (envDir: ".." en vite.config.ts); ver .env.example de la
# raíz.

# Renovación del token, en segundos.
VITE_TOKEN_REFRESH=90
# Cierre de sesión por inactividad, en minutos.
VITE_SESSION_TIMEOUT=30