# LOCAL: http://localhost:8000/api  |  PROD: https://api.url.com/api
VITE_API_URL=http://localhost:8000/api
VITE_GCP_API_KEY="your-gcp-api-key"
# Reference keys for the SPA.
# IMPORTANT: local `VITE_*` values are loaded from the repo root `.env`
# because `frontend/vite.config.ts` uses `envDir: ".."`.
# Do not place local SPA overrides in `frontend/.env`.
# LOCAL: http://localhost:5173  |  PROD: https://app.url.com
VITE_FRONTEND_URL=http://localhost:5173
# LOCAL: http://localhost:4321/  |  PROD: https://url.com/
VITE_LANDING_URL=http://localhost:4321/
VITE_APP_LOGIN_URL=http://localhost:5173/auth/login

VITE_TOKEN_REFRESH=90
VITE_SESSION_TIMEOUT=30
