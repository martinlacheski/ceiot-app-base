# Frontend (React + Vite). Copiar a frontend/.env.
#
# Docker: docker-compose.yml interpola este archivo para el puerto publicado y
# para los argumentos de compilación de la imagen. Las VITE_* quedan fijas en
# el bundle: si cambian, reconstruya la imagen (scripts/levantar.sh --build).
#
# `npm run dev` (fuera de Docker) NO lee este archivo: Vite toma las variables
# del .env de la raíz del repositorio (envDir: ".." en vite.config.ts). Para
# ese caso, copie estas mismas variables a un .env en la raíz.

# Puerto publicado en 127.0.0.1 (dentro del contenedor, Nginx escucha en 80).
VITE_FRONTEND_PORT=5173
# API del backend (BACKEND_PORT de backend/.env), con el sufijo /api.
VITE_API_URL=http://localhost:8000/api
VITE_APP_LOGIN_URL=http://localhost:5173/auth/login
# Landing (LANDING_PORT de landing/.env).
VITE_LANDING_URL=http://localhost:4321
# Clave de Google Maps (mapas y selector de ubicación). Sin una clave válida la
# aplicación funciona, pero los mapas no cargan.
VITE_GCP_API_KEY=
# Renovación del token, en segundos.
VITE_TOKEN_REFRESH=90
# Cierre de sesión por inactividad, en minutos.
VITE_SESSION_TIMEOUT=30
